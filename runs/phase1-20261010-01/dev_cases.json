      "period": {
        "start_inclusive": "2026-01-01",
        "end_exclusive": "2026-02-01"
      },
      "group_by": [
        "category"
      ],
      "metric": {
        "operation": "sum",
        "field": "amount_cents",
        "unit": "cents"
      },
      "output": {
        "format": "markdown",
        "language": "en",
        "title": "Usage report"
      }
    }
  },
  "roles": {
    "load": "raw_records",
    "normalize": "normalized_records",
    "aggregate": "aggregate",
    "render": "report"
