  "task_contracts": [
    {
      "task_id": "load",
      "upstream_tasks": [],
      "direct_requirement_fields": [
        "dataset_id"
      ],
      "contract": "Load every row from the fixed source snapshot. Record actual source hash and schema."
    },
    {
      "task_id": "normalize",
      "upstream_tasks": [
        "load"
      ],
      "direct_requirement_fields": [],
      "contract": "Parse dates and integer cents. Preserve every source row from all periods. Record provenance and schema."
    },
    {
      "task_id": "aggregate",
      "upstream_tasks": [
        "normalize"
      ],
      "direct_requirement_fields": [
        "period",
        "group_by",
        "metric"
      ],
      "contract": "Select records in [start_inclusive, end_exclusive), sum integer cents by category, and retain period, grouping, unit, metric and source provenance."
    },
    {
      "task_id": "render",
      "upstream_tasks": [
        "aggregate"
      ],
      "direct_requirement_fields": [
        "output"
      ],
      "contract": "Render the aggregate with the required format, language and title. Preserve the aggregate's period, units, categories and totals."
    }
  ],
